;;; centaur-tabs-auto-hide-tests.el --- Single-tab visibility tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'centaur-tabs)

(defmacro centaur-tabs-test-with-buffers (names &rest body)
  "Run BODY with fresh buffers NAMES and isolated Centaur state."
  (declare (indent 1))
  `(let* ((buffers (mapcar #'get-buffer-create ,names))
          (centaur-tabs-buffer-list-function (lambda () buffers))
          (centaur-tabs-buffer-groups-function
           (lambda () (list (if (string-prefix-p "other-" (buffer-name))
                                "other" "main"))))
          (centaur-tabs-hide-single-tab t)
          (centaur-tabs-hide-predicate #'ignore)
          (centaur-tabs-set-icons nil)
          (centaur-tabs-show-new-tab-button nil)
          (centaur-tabs-show-navigation-buttons nil))
     (unwind-protect
         (progn
           (centaur-tabs-mode 1)
           ,@body)
       (centaur-tabs-mode -1)
       (dolist (buffer buffers)
         (when (buffer-live-p buffer)
           (kill-buffer buffer))))))

(ert-deftest centaur-tabs-auto-hide-single-to-two-to-single ()
  (centaur-tabs-test-with-buffers '("ct-one")
    (switch-to-buffer (car buffers))
    (centaur-tabs-line)
    (should-not (eval centaur-tabs-display-line-format))
    (let ((second (get-buffer-create "ct-two")))
      (push second buffers)
      (switch-to-buffer second)
      (centaur-tabs-line)
      (should (eval centaur-tabs-display-line-format))
      (switch-to-buffer (get-buffer "ct-one"))
      (centaur-tabs-line)
      (should (eval centaur-tabs-display-line-format))
      (setq buffers (delq second buffers))
      (kill-buffer second)
      ;; In an interactive frame window-buffer-change-functions updates the
      ;; tabset on redisplay; batch ERT has no such redisplay cycle.
      (centaur-tabs-buffer-update-groups)
      (centaur-tabs-line)
      (should-not (eval centaur-tabs-display-line-format)))))

(ert-deftest centaur-tabs-auto-hide-counts-current-group-only ()
  (centaur-tabs-test-with-buffers '("ct-main" "other-ct")
    (switch-to-buffer (get-buffer "ct-main"))
    (centaur-tabs-line)
    (should-not (eval centaur-tabs-display-line-format))
    (switch-to-buffer (get-buffer "other-ct"))
    (centaur-tabs-line)
    (should-not (eval centaur-tabs-display-line-format))))

(ert-deftest centaur-tabs-auto-hide-preserves-explicit-hide ()
  (centaur-tabs-test-with-buffers '("ct-one" "ct-two")
    (switch-to-buffer (get-buffer "ct-one"))
    (let ((centaur-tabs-hide-predicate (lambda () t)))
      (centaur-tabs-line)
      (should-not (eval centaur-tabs-display-line-format)))))

(ert-deftest centaur-tabs-auto-hide-restores-local-format ()
  (centaur-tabs-test-with-buffers '("ct-one")
    (switch-to-buffer (car buffers))
    (set (make-local-variable centaur-tabs-display-line-format) "custom")
    (centaur-tabs-line)
    (should-not (eval centaur-tabs-display-line-format))
    (let ((second (get-buffer-create "ct-two")))
      (push second buffers)
      (centaur-tabs-buffer-update-groups)
      (should (equal (eval centaur-tabs-display-line-format) "custom")))))

(ert-deftest centaur-tabs-auto-hide-disable-mode-cleans-up ()
  (centaur-tabs-test-with-buffers '("ct-one")
    (switch-to-buffer (car buffers))
    (centaur-tabs-line)
    (should-not (eval centaur-tabs-display-line-format))
    (centaur-tabs-mode -1)
    (should-not centaur-tabs--hidden-single-tab)
    (centaur-tabs-mode 1)
    (should (eval centaur-tabs-display-line-format))))

(ert-deftest centaur-tabs-auto-hide-respects-later-local-hide ()
  (centaur-tabs-test-with-buffers '("ct-one")
    (switch-to-buffer (car buffers))
    (centaur-tabs-line)
    (centaur-tabs-local-mode 1)
    (let ((second (get-buffer-create "ct-two")))
      (push second buffers)
      (centaur-tabs-buffer-update-groups)
      (should centaur-tabs-local-mode)
      (should-not (eval centaur-tabs-display-line-format))
      (centaur-tabs-local-mode -1)
      (should (eval centaur-tabs-display-line-format)))))

(ert-deftest centaur-tabs-auto-hide-default-is-off ()
  (should-not (default-value 'centaur-tabs-hide-single-tab)))

(ert-deftest centaur-tabs-auto-hide-isolates-groups-after-growth ()
  (centaur-tabs-test-with-buffers '("ct-one" "ct-two" "other-ct")
    (switch-to-buffer (get-buffer "ct-one"))
    (centaur-tabs-line)
    (should (eval centaur-tabs-display-line-format))
    (switch-to-buffer (get-buffer "other-ct"))
    (centaur-tabs-line)
    (should-not (eval centaur-tabs-display-line-format))))

(ert-deftest centaur-tabs-auto-hide-empty-tabset-idempotent ()
  "An ungrouped buffer must not retain an empty tab-line row."
  (centaur-tabs-test-with-buffers '("ct-ungrouped")
    (switch-to-buffer (car buffers))
    (cl-letf (((symbol-function 'centaur-tabs-current-tabset)
               (lambda (&optional _recalc) nil)))
      (should (equal (default-value centaur-tabs-display-line-format)
                     centaur-tabs-header-line-format))
      (dotimes (_ 3)
        (centaur-tabs-line)
        (should centaur-tabs--hidden-single-tab)
        (should (local-variable-p centaur-tabs-display-line-format))
        (should-not (eval centaur-tabs-display-line-format))))
    (centaur-tabs-mode -1)
    (should-not centaur-tabs--hidden-single-tab)
    (should-not (local-variable-p centaur-tabs-display-line-format))
    (centaur-tabs-mode 1)
    (should (eval centaur-tabs-display-line-format))))

(ert-deftest centaur-tabs-auto-hide-empty-tabset-to-two-tabs ()
  "An initially empty group must show the bar when it gains two tabs."
  (centaur-tabs-test-with-buffers '("ct-ungrouped")
    (switch-to-buffer (car buffers))
    (cl-letf (((symbol-function 'centaur-tabs-current-tabset)
               (lambda (&optional _recalc) nil)))
      (centaur-tabs-line))
    (should-not (eval centaur-tabs-display-line-format))
    (centaur-tabs-line)
    (should-not (eval centaur-tabs-display-line-format))
    (let ((second (get-buffer-create "ct-second")))
      (push second buffers)
      (centaur-tabs-buffer-update-groups)
      (should-not centaur-tabs--hidden-single-tab)
      (should-not (local-variable-p centaur-tabs-display-line-format))
      (should (eval centaur-tabs-display-line-format))
      (setq buffers (delq second buffers))
      (kill-buffer second)
      (centaur-tabs-buffer-update-groups)
      (centaur-tabs-line)
      (should-not (eval centaur-tabs-display-line-format)))))

(ert-deftest centaur-tabs-auto-hide-empty-tabset-default-off ()
  "With the opt-in disabled, an absent tabset keeps the old format."
  (centaur-tabs-test-with-buffers '("ct-ungrouped")
    (switch-to-buffer (car buffers))
    (let ((centaur-tabs-hide-single-tab nil))
      (cl-letf (((symbol-function 'centaur-tabs-current-tabset)
                 (lambda (&optional _recalc) nil)))
        (should-not (centaur-tabs-line))
        (should-not centaur-tabs--hidden-single-tab)
        (should-not (local-variable-p centaur-tabs-display-line-format))
        (should (eval centaur-tabs-display-line-format))))))

(ert-deftest centaur-tabs-auto-hide-empty-tabset-restores-local-format ()
  "Auto-hiding must preserve existing local formatting across toggles."
  (centaur-tabs-test-with-buffers '("ct-ungrouped")
    (switch-to-buffer (car buffers))
    (set (make-local-variable centaur-tabs-display-line-format) "custom")
    (cl-letf (((symbol-function 'centaur-tabs-current-tabset)
               (lambda (&optional _recalc) nil)))
      (dotimes (_ 3)
        (centaur-tabs-line)
        (should-not (eval centaur-tabs-display-line-format))))
    (centaur-tabs-mode -1)
    (should (equal (eval centaur-tabs-display-line-format) "custom"))
    (centaur-tabs-mode 1)
    (should (equal (eval centaur-tabs-display-line-format) "custom"))))

(ert-deftest centaur-tabs-auto-hide-ungrouped-buffer-vanilla ()
  "A real ungrouped buffer hides its row without Doom or a stubbed tabset."
  (centaur-tabs-test-with-buffers '("ct-ungrouped")
    (let ((centaur-tabs-buffer-groups-function (lambda () nil)))
      (switch-to-buffer (car buffers))
      (should-not (centaur-tabs-current-tabset t))
      (centaur-tabs-line)
      (should centaur-tabs--hidden-single-tab)
      (should (local-variable-p centaur-tabs-display-line-format))
      (should-not (eval centaur-tabs-display-line-format)))))

(provide 'centaur-tabs-auto-hide-tests)
;;; centaur-tabs-auto-hide-tests.el ends here

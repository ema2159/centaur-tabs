;;; centaur-tabs-auto-hide-tests.el --- Single-tab visibility tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'centaur-tabs)

(defmacro centaur-tabs-test-with-buffers (names &rest body)
  "Run BODY with fresh buffers NAMES and isolated Centaur state."
  (declare (indent 1))
  `(let* ((buffers (mapcar #'get-buffer-create ,names))
          (centaur-tabs-buffer-list-function (lambda () buffers))
          (centaur-tabs-buffer-groups-function
           (lambda () (list (if (string-prefix-p "other-" (buffer-name))
                                "other" "main"))))
          (centaur-tabs-hide-single-tab t)
          (centaur-tabs-hide-predicate #'ignore)
          (centaur-tabs-set-icons nil)
          (centaur-tabs-show-new-tab-button nil)
          (centaur-tabs-show-navigation-buttons nil))
     (unwind-protect
         (progn
           (centaur-tabs-mode 1)
           ,@body)
       (centaur-tabs-mode -1)
       (dolist (buffer buffers)
         (when (buffer-live-p buffer)
           (kill-buffer buffer))))))

(ert-deftest centaur-tabs-auto-hide-single-to-two-to-single ()
  (centaur-tabs-test-with-buffers '("ct-one")
    (switch-to-buffer (car buffers))
    (centaur-tabs-line)
    (should-not (eval centaur-tabs-display-line-format))
    (let ((second (get-buffer-create "ct-two")))
      (push second buffers)
      (switch-to-buffer second)
      (centaur-tabs-line)
      (should (eval centaur-tabs-display-line-format))
      (switch-to-buffer (get-buffer "ct-one"))
      (centaur-tabs-line)
      (should (eval centaur-tabs-display-line-format))
      (setq buffers (delq second buffers))
      (kill-buffer second)
      ;; In an interactive frame window-buffer-change-functions updates the
      ;; tabset on redisplay; batch ERT has no such redisplay cycle.
      (centaur-tabs-buffer-update-groups)
      (centaur-tabs-line)
      (should-not (eval centaur-tabs-display-line-format)))))

(ert-deftest centaur-tabs-auto-hide-counts-current-group-only ()
  (centaur-tabs-test-with-buffers '("ct-main" "other-ct")
    (switch-to-buffer (get-buffer "ct-main"))
    (centaur-tabs-line)
    (should-not (eval centaur-tabs-display-line-format))
    (switch-to-buffer (get-buffer "other-ct"))
    (centaur-tabs-line)
    (should-not (eval centaur-tabs-display-line-format))))

(ert-deftest centaur-tabs-auto-hide-preserves-explicit-hide ()
  (centaur-tabs-test-with-buffers '("ct-one" "ct-two")
    (switch-to-buffer (get-buffer "ct-one"))
    (let ((centaur-tabs-hide-predicate (lambda () t)))
      (centaur-tabs-line)
      (should-not (eval centaur-tabs-display-line-format)))))

(ert-deftest centaur-tabs-auto-hide-restores-local-format ()
  (centaur-tabs-test-with-buffers '("ct-one")
